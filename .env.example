# ============================================
# NutriPredic — plantilla de entorno
# Copia a .env y ajusta los valores:
#   cp .env.example .env
# ============================================

# ============================================
# BASE DE DATOS — ejecución LOCAL (java -jar / IDE)
# application.properties las lee como DB_URL/DB_USERNAME/DB_PASSWORD
# ============================================
DB_URL=jdbc:postgresql://localhost:5432/nutripredic
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ============================================
# BASE DE DATOS — DOCKER (servicio postgres de docker-compose.yml)
# deploy.sh exige POSTGRES_PASSWORD no vacío
# ============================================
POSTGRES_DB=nutripredic
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_password_en_produccion

# ============================================
# JWT / SEGURIDAD (mínimo 32 caracteres)
# Genera con: openssl rand -base64 32
# ============================================
JWT_SECRET=tu-clave-secreta-super-secreta-de-al-menos-32-caracteres
JWT_EXPIRATION_MS=86400000

# CORS — orígenes permitidos separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://tudominio.com

# ============================================
# ADMINISTRADOR INICIAL
# ============================================
ADMIN_EMAIL=admin@nutripredic.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Administrador

# ============================================
# SERVICIO DE IA (Python/FastAPI)
# Local: http://localhost:8000/predict
# Docker: http://ai:8000/predict (ya fijado en docker-compose.yml)
# ============================================
AI_SERVICE_URL=http://localhost:8000/predict

# ============================================
# SERVICIO ML (opcional: application.properties trae estos mismos
# valores por defecto, solo defínelos si difieren)
# ============================================
# NUTRIPREDICT_ML_BASE_URL=http://localhost:8000
# NUTRIPREDICT_ML_PREDICT_PATH=/predict
# NUTRIPREDICT_ML_TIMEOUT=PT5S

# ============================================
# GEMINI (Google AI)
# OJO: la app la lee como API_KEY_GEMINI (ver application.properties),
# no como GEMINI_API_KEY
# ============================================
API_KEY_GEMINI=tu_api_key_de_gemini
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT=PT60S
GEMINI_MOCK_ENABLED=false

# ============================================
# SOLO DOCKER (ya fijadas en docker-compose.yml / Dockerfile,
# se listan aquí como referencia; no hace falta definirlas)
# ============================================
# SPRING_PROFILES_ACTIVE=docker
# SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/nutripredic
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres
# SPRING_JPA_HIBERNATE_DDL_AUTO=validate
# SPRING_FLYWAY_ENABLED=true
# SPRING_FLYWAY_LOCATIONS=classpath:db/migration
# SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
# SPRING_JPA_OPEN_IN_VIEW=false
# JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0

# USDA FoodData Central: free server-side key; DEMO_KEY is only for limited trials.
FDC_API_KEY=DEMO_KEY
